{
  "name": "@drixev/sage",
  "version": "0.1.0",
  "description": "IA-powered git assistant CLI - smarter commits, PR summaries & code reviews",
  "main": "index.js",
  "type": "module",
  "bin": {
    "sage": "./dist/bin/app.js"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.js",
    "dev": "tsx src/bin/app.ts",
    "start": "node dist/bin/app.js",
    "lint": "eslint src",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "git",
    "drixev",
    "sage",
    "ai",
    "cli",
    "anthropic"
  ],
  "author": "drixev",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/drixev-tools/sage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "openai": "^6.37.0",
    "ora": "^9.4.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}