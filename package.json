{
  "name": "@drixev/sage",
  "version": "1.0.0",
  "description": "IA-powered git assistant CLI - smarter commits, PR summaries & code reviews",
  "main": "index.js",
  "type": "module",
  "bin": {
    "sage": "./dist/bin/app.js"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.js",
    "dev": "tsx src/bin/app.ts",
    "start": "node dist/bin/app.js",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "git",
    "drixev",
    "sage",
    "ai",
    "cli",
    "anthropic"
  ],
  "author": "drixev",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/drixev-tools/sage"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "openai": "^6.37.0",
    "ora": "^9.4.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}